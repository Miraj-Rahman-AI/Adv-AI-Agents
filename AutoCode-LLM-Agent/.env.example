
# Supported: mock, openai, ollama
LLM_PROVIDER=mock

# OpenAI-compatible hosted inference
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Local inference
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:8b

# Inference settings
LLM_TIMEOUT=60
LLM_MAX_TOKENS=2000

# Execution settings
MAX_CONCURRENCY=3
MAX_RETRIES=1
MAX_TASKS=12

# Workspace
WORKSPACE_PATH=.
